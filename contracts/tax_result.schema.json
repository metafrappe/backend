{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metafrappe.example/contracts/tax_result.schema.json",
  "title": "Price and tax result",
  "description": "Shared price and tax result for screen, invoice document and ledger (AJA-1756). Rules: contracts/tax-result.md. All rates in examples are fictional.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "idempotency_key",
    "billing_country",
    "currency",
    "lines",
    "totals",
    "invoice"
  ],
  "properties": {
    "operation": {
      "enum": [
        "quote",
        "purchase",
        "refund"
      ],
      "description": "quote is a read and needs no key. purchase and refund need an idempotency key (contracts/idempotency.md)."
    },
    "idempotency_key": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "billing_country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "description": "ISO 3166-1 alpha-2 country of the billing address. This decides the tax. The UI language never does."
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/line"
      }
    },
    "totals": {
      "$ref": "#/$defs/totals"
    },
    "invoice": {
      "oneOf": [
        {
          "$ref": "#/$defs/invoiceSnapshot"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "quote"
          }
        }
      },
      "then": {
        "properties": {
          "idempotency_key": {
            "type": "null"
          },
          "invoice": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "idempotency_key": {
            "type": "string"
          }
        }
      }
    }
  ],
  "x-rounding": {
    "scale": 2,
    "mode": "ROUND_HALF_EVEN",
    "level": "line",
    "description": "Tax is rounded on each line to two decimals, half to even (banker's rounding). Totals are exact sums of rounded lines and are never rounded again. Source: G-41 currency_precision=2 and K-8 rounding_method. Rules: contracts/tax-result.md, section Yuvarlama."
  },
  "$defs": {
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "currency"
      ],
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$",
          "description": "Decimal text with a dot and exactly two decimals. Never a float. Display formatting is the client's job. Rounding: x-rounding."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "taxStatus": {
      "enum": [
        "calculated",
        "zero_rated",
        "exempt",
        "reverse_charge",
        "not_calculated",
        "service_unavailable"
      ]
    },
    "reasonCode": {
      "enum": [
        "TAX_STANDARD_RATE",
        "TAX_REDUCED_RATE",
        "TAX_ZERO_RATE_EXPORT",
        "TAX_ZERO_RATE_GOODS",
        "TAX_EXEMPT_BY_LAW",
        "TAX_EXEMPT_CUSTOMER",
        "TAX_REVERSE_CHARGE_B2B",
        "TAX_MISSING_BILLING_COUNTRY",
        "TAX_UNSUPPORTED_COUNTRY",
        "TAX_MISSING_TAX_ID",
        "TAX_SERVICE_UNAVAILABLE",
        "TAX_SERVICE_TIMEOUT"
      ]
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line_id",
        "description",
        "net",
        "tax_rate",
        "tax",
        "gross",
        "tax_status",
        "reason_code",
        "label_key_short",
        "label_key_long"
      ],
      "properties": {
        "line_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "net": {
          "$ref": "#/$defs/money"
        },
        "tax_rate": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,4})?$",
              "description": "Percent as decimal text."
            },
            {
              "type": "null"
            }
          ]
        },
        "tax": {
          "oneOf": [
            {
              "$ref": "#/$defs/money"
            },
            {
              "type": "null"
            }
          ]
        },
        "gross": {
          "oneOf": [
            {
              "$ref": "#/$defs/money"
            },
            {
              "type": "null"
            }
          ]
        },
        "tax_status": {
          "$ref": "#/$defs/taxStatus"
        },
        "reason_code": {
          "$ref": "#/$defs/reasonCode"
        },
        "label_key_short": {
          "type": "string",
          "pattern": "^tax\\.status\\.[a-z_]+\\.short$",
          "description": "Short status text key for a 320 px screen."
        },
        "label_key_long": {
          "type": "string",
          "pattern": "^tax\\.status\\.[a-z_]+\\.long$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "tax_status": {
                "enum": [
                  "not_calculated",
                  "service_unavailable"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "tax": {
                "type": "null"
              },
              "gross": {
                "type": "null"
              },
              "tax_rate": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "tax": {
                "$ref": "#/$defs/money"
              },
              "gross": {
                "$ref": "#/$defs/money"
              }
            }
          }
        }
      ]
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "net",
        "tax",
        "gross"
      ],
      "properties": {
        "net": {
          "$ref": "#/$defs/money"
        },
        "tax": {
          "oneOf": [
            {
              "$ref": "#/$defs/money"
            },
            {
              "type": "null"
            }
          ]
        },
        "gross": {
          "oneOf": [
            {
              "$ref": "#/$defs/money"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "invoiceSnapshot": {
      "type": "object",
      "readOnly": true,
      "additionalProperties": false,
      "description": "Frozen copy made when the invoice is issued. A later rate change never edits it.",
      "required": [
        "invoice_number",
        "issued_on",
        "currency",
        "lines",
        "totals"
      ],
      "properties": {
        "invoice_number": {
          "type": "string",
          "minLength": 1
        },
        "issued_on": {
          "type": "string",
          "format": "date"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/line"
          }
        },
        "totals": {
          "$ref": "#/$defs/totals"
        }
      }
    }
  },
  "x-reason-codes": {
    "calculated": [
      "TAX_STANDARD_RATE",
      "TAX_REDUCED_RATE"
    ],
    "zero_rated": [
      "TAX_ZERO_RATE_EXPORT",
      "TAX_ZERO_RATE_GOODS"
    ],
    "exempt": [
      "TAX_EXEMPT_BY_LAW",
      "TAX_EXEMPT_CUSTOMER"
