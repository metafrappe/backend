    "reverse_charge": [
      "TAX_REVERSE_CHARGE_B2B"
    ],
    "not_calculated": [
      "TAX_MISSING_BILLING_COUNTRY",
      "TAX_UNSUPPORTED_COUNTRY",
      "TAX_MISSING_TAX_ID"
    ],
    "service_unavailable": [
      "TAX_SERVICE_UNAVAILABLE",
      "TAX_SERVICE_TIMEOUT"
    ]
  },
  "x-label-keys": {
    "calculated": {
      "short": "tax.status.calculated.short",
      "long": "tax.status.calculated.long"
    },
    "zero_rated": {
      "short": "tax.status.zero_rated.short",
      "long": "tax.status.zero_rated.long"
