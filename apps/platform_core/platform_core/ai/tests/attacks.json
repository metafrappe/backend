{
  "schema": 1,
  "about": "Attack examples for the tenant AI layer (G-89). test_prompt_injection.py sends every case through the real MCP endpoint as the given user.",
  "cases": [
    {
      "id": "approval-field-on-write",
      "category": "approval_bypass",
      "user": "owner",
      "tool": "plt_update_document",
      "arguments": {"doctype": "$doctype", "name": "$own_record", "data": {"title": "x"}, "approved": true},
      "deny": "invalid_arguments"
    },
    {
      "id": "confirm-field-on-read",
      "category": "approval_bypass",
      "user": "owner",
      "tool": "plt_get_document",
      "arguments": {"doctype": "$doctype", "name": "$own_record", "confirm": true},
      "deny": "invalid_arguments"
    },
    {
      "id": "other-users-record",
      "category": "scope",
      "user": "other",
      "tool": "plt_get_document",
      "arguments": {"doctype": "$doctype", "name": "$own_record"},
      "deny": "permission"
    },
    {
      "id": "write-to-other-users-record",
      "category": "scope",
      "user": "other",
      "tool": "plt_update_document",
      "arguments": {"doctype": "$doctype", "name": "$own_record", "data": {"title": "taken"}},
      "deny": "permission"
    },
    {
      "id": "admin-tool-without-role",
      "category": "privilege",
      "user": "owner",
      "tool": "plt_assign_role",
      "arguments": {"user": "$owner", "role": "System Manager"},
      "deny": "role_required"
    },
    {
      "id": "code-doctype-write",
      "category": "privilege",
      "user": "manager",
      "tool": "plt_create_document",
      "arguments": {"doctype": "Server Script", "data": {"name": "x", "script_type": "API", "script": "pass"}},
      "deny": "blocked_doctype"
    },
    {
      "id": "credential-doctype-read",
      "category": "exfiltration",
      "user": "manager",
      "tool": "plt_list_documents",
      "arguments": {"doctype": "OAuth Bearer Token"},
      "deny": "blocked_doctype"
    },
    {
      "id": "own-audit-log-delete",
      "category": "tool_limit",
      "user": "manager",
      "tool": "plt_delete_document",
      "arguments": {"doctype": "PLT AI Action Log", "name": "x"},
      "deny": "blocked_doctype"
    }
  ]
}
