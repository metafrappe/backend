#!/usr/bin/env bash
# Connects the gitleaks pre-commit hook (G-112) without touching the personal author guard.
# The guard lives in core.hooksPath and runs the repository hook first. Without a guard Git runs
# the repository hook itself. This script writes only that repository hook; core.hooksPath and
# the guard stay as they are. Design: docs/dagitim/secrets.md.
set -euo pipefail

if [[ $# -ne 0 ]]; then
    printf '%s\n' 'Usage: install-secret-hook' >&2
    exit 2
fi

marker='# installed by dev/bin/install-secret-hook (G-112)'
hooks_dir="$(git rev-parse --path-format=absolute --git-common-dir)/hooks"
hook="$hooks_dir/pre-commit"

if [[ -e "$hook" ]] && ! grep -qxF "$marker" "$hook"; then
    printf '%s\n' "A different pre-commit hook already exists: $hook" \
        'Add the gitleaks call to it by hand. This script does not replace it.' >&2
    exit 1
fi

mkdir -p "$hooks_dir"
tmp="$(mktemp "$hooks_dir/.pre-commit.XXXXXX")"
cat > "$tmp" <<HOOK
#!/bin/sh
$marker
# Stops the commit when gitleaks finds a secret in the staged change.
root=\$(git rev-parse --show-toplevel) || exit 1
if ! command -v pre-commit >/dev/null 2>&1; then
    echo 'pre-commit is not installed; the secret scan cannot run. Commit stopped.' >&2
    exit 1
fi
exec pre-commit run gitleaks --hook-stage pre-commit --config "\$root/apps/platform_core/.pre-commit-config.yaml"
HOOK
chmod 0755 "$tmp"
mv "$tmp" "$hook"
printf '%s\n' "Secret hook installed: $hook"
